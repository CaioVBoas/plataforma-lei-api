generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PapelUsuario {
  DOCENTE
  ESTUDANTE
  PARCEIRO
}

enum NivelCurso {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}

enum TipoParceiro {
  ORGAO_PUBLICO
  UNIDADE_UFPE
  ORGANIZACAO_SOCIAL_ONG
  EMPRESA
  OUTRO
}

enum ViabilidadeEscopo {
  CABE_NO_SEMESTRE
  APERTADO_EXIGE_RECORTE
}

enum EtapaSubmissao {
  RASCUNHO
  EM_TRIAGEM
  AJUSTE_PEDIDO
  PUBLICADA
}

enum AdocaoResultado {
  EM_USO
  PARCIAL
  NAO_USADO
}

enum EtapaProjeto {
  PLANO
  KICKOFF
  SIGAA
  PARCIAL
  FINAL
  ENCERRAMENTO
}

// ---------------------------------------------------------------------------
// Calendário Semestral Oficial
// ---------------------------------------------------------------------------

model AcademicCalendar {
  id           Int      @id @default(autoincrement())
  semester     String   @unique
  startsAt     DateTime
  endsAt       DateTime
  linkDeadline DateTime
  midtermAt    DateTime
  finalAt      DateTime
  isCurrent    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courses Course[]

  @@map("academic_calendars")
}

// ---------------------------------------------------------------------------
// Usuários e Perfis
// ---------------------------------------------------------------------------

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  passwordHash String
  role         PapelUsuario
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  professor Professor?
  student   Student?
  partner   Partner?

  authoredQuestions DemandQuestion[] @relation("QuestionAuthor")

  @@map("users")
}

model Professor {
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique
  name                String
  department          String   @default("Centro de Informática")
  phone               String?
  photo               String?  @db.Text
  tutorialSeen        Boolean  @default(false)
  academicRole        String   @default("Docente")
  paused              Boolean  @default(false)
  projectsPerSemester Int      @default(2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses         Course[]           @relation("MainProfessor")
  coTaughtCourses CourseProfessor[]
  reservedDemands Demand[]           @relation("DemandReservation")
  watchedDemands  DemandWatcher[]
  invitations     DemandInvitation[]
  questionsAsked  DemandQuestion[]

  @@map("professors")
}

model Student {
  id                 Int      @id @default(autoincrement())
  userId             Int?     @unique
  name               String
  registrationNumber String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("students")
}

model Partner {
  id             Int          @id @default(autoincrement())
  userId         Int?         @unique
  name           String
  type           TipoParceiro
  location       String?
  about          String?      @db.Text
  audience       String?
  site           String?
  meetingCadence String?
  onSiteVisit    String?
  logo           String?      @db.Text
  cover          String?      @db.Text
  focalName      String?
  focalRole      String?
  phone          String?
  channel        String?      @default("E-mail")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?    @relation(fields: [userId], references: [id])
  demands Demand[]

  @@map("partners")
}

// ---------------------------------------------------------------------------
// Disciplinas (Turmas do Semestre)
// ---------------------------------------------------------------------------

model Course {
  id               Int        @id @default(autoincrement())
  professorId      Int
  name             String
  code             String
  semester         String
  enrolledStudents Int
  teamSize         Int        @default(5)
  expectedLevel    NivelCurso @default(INTERMEDIARIO)
  projectCapacity  Int        @default(1)
  syllabus         String?    @db.Text
  acceptsDemands   Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  professor  Professor         @relation("MainProfessor", fields: [professorId], references: [id], onDelete: Cascade)
  calendar   AcademicCalendar? @relation(fields: [semester], references: [semester])
  coTeachers CourseProfessor[]
  skills     CourseSkill[]
  projects   Project[]

  @@unique([professorId, code, semester])
  @@map("courses")
}

model CourseProfessor {
  courseId    Int
  professorId Int

  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@id([courseId, professorId])
  @@map("course_professors")
}

// ---------------------------------------------------------------------------
// Competências (Skills)
// ---------------------------------------------------------------------------

model Skill {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  weight    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  demandSkills DemandSkill[]
  courseSkills CourseSkill[]

  @@map("skills")
}

model DemandSkill {
  demandId  Int
  skillId   Int
  createdAt DateTime @default(now())

  demand Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([demandId, skillId])
  @@map("demand_skills")
}

model CourseSkill {
  courseId  Int
  skillId   Int
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([courseId, skillId])
  @@map("course_skills")
}

// ---------------------------------------------------------------------------
// Demandas, Submissão, Triagem e Interações
// ---------------------------------------------------------------------------

model Demand {
  id                    Int               @id @default(autoincrement())
  partnerId             Int
  title                 String
  problem               String            @db.Text
  description           String            @db.Text
  affectedAudience      String
  expectedOutcome       String?           @db.Text
  location              String?
  since                 String?
  level                 NivelCurso        @default(INTERMEDIARIO)
  scopeFit              ViabilidadeEscopo @default(CABE_NO_SEMESTRE)
  scopeNote             String?           @db.Text
  meetingCadence        String?
  constraints           String[]
  offers                String[]

  // Triagem e ciclo de vida
  stage                 EtapaSubmissao    @default(PUBLICADA)
  submittedAt           DateTime?
  reviewNote            String?           @db.Text
  reviewedBy            String?
  reviewedAt            DateTime?
  publishedAt           DateTime?

  // Reserva do Cardápio
  reservedByProfessorId Int?
  reservationDeadline   DateTime?

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  partner             Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  reservedByProfessor Professor?         @relation("DemandReservation", fields: [reservedByProfessorId], references: [id])
  skills              DemandSkill[]
  references          Reference[]
  questions           DemandQuestion[]
  watchers            DemandWatcher[]
  invitations         DemandInvitation[]
  project             Project?

  @@map("demands")
}

model DemandWatcher {
  demandId    Int
  professorId Int
  createdAt   DateTime @default(now())

  demand    Demand    @relation(fields: [demandId], references: [id], onDelete: Cascade)
  professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@id([demandId, professorId])
  @@map("demand_watchers")
}

model DemandInvitation {
  id          Int      @id @default(autoincrement())
  demandId    Int
  professorId Int
  fromName    String
  message     String   @db.Text
  sentAt      DateTime @default(now())

  demand    Demand    @relation(fields: [demandId], references: [id], onDelete: Cascade)
  professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@map("demand_invitations")
}

model DemandQuestion {
  id         Int       @id @default(autoincrement())
  demandId   Int
  teacherId  Int
  authorId   Int?
  text       String    @db.Text
  askedAt    DateTime  @default(now())
  answerText String?   @db.Text
  answeredBy String?
  answeredAt DateTime?

  demand  Demand    @relation(fields: [demandId], references: [id], onDelete: Cascade)
  teacher Professor @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  author  User?     @relation("QuestionAuthor", fields: [authorId], references: [id])

  @@map("demand_questions")
}

model Reference {
  id          Int      @id @default(autoincrement())
  demandId    Int
  name        String
  url         String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  demand Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)

  @@map("references")
}

// ---------------------------------------------------------------------------
// Projetos, 6 Etapas e Plano Institucional
// ---------------------------------------------------------------------------

model Project {
  id                Int              @id @default(autoincrement())
  demandId          Int              @unique
  courseId          Int
  title             String
  agreedDeliverable String?          @db.Text
  teams             Int              @default(1)
  sigaaCode         String?
  outcomeSummary    String?          @db.Text
  outcomeAdoption   AdocaoResultado?
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  demand           Demand             @relation(fields: [demandId], references: [id])
  course           Course             @relation(fields: [courseId], references: [id])
  milestones       ProjectMilestone[]
  proposalSections ProposalSection[]
  workloads        Workload[]

  @@map("projects")
}

model ProjectMilestone {
  id        Int          @id @default(autoincrement())
  projectId Int
  step      EtapaProjeto
  dueAt     DateTime
  doneAt    DateTime?
  note      String?      @db.Text

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, step])
  @@map("project_milestones")
}

model ProposalSection {
  id        Int      @id @default(autoincrement())
  projectId Int
  title     String
  limit     Int      @default(2000)
  text      String   @db.Text
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, order])
  @@map("proposal_sections")
}

model Workload {
  id           Int      @id @default(autoincrement())
  projectId    Int
  activity     String
  hours        Int
  participants String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("workloads")
}
