PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plataforma_lei_db?schema=public"
JWT_SECRET="chave-secreta-para-desenvolvimento-local-mude-em-producao"
FRONTEND_URL="http://localhost:5173"

# E-mail (nodemailer). Com MAIL_ENABLED diferente de true, os e-mails só aparecem no log.
MAIL_ENABLED=false
# Servidor SMTP (obrigatório com MAIL_ENABLED=true)
SMTP_HOST=
# Porta SMTP (padrão 587; 465 usa conexão segura)
SMTP_PORT=
# Usuário SMTP (deixe vazio para relay sem login)
SMTP_USER=
# Senha SMTP
SMTP_PASS=
# Remetente dos e-mails (obrigatório com MAIL_ENABLED=true)
MAIL_FROM=
